{
  "name": "temperature-emotion-box",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ESP32-S3 + DS18B20 temperature companion with an official DeepSeek Harness plugin",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/standalone.mjs",
    "dev": "node scripts/dev.mjs",
    "plugin:install": "npm run plugin:pack && node scripts/install-plugin.mjs",
    "firmware:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-firmware.ps1",
    "plugin:pack": "npm pack ./plugins/temperature --pack-destination .local",
    "test": "node --test tests/*.test.mjs",
    "dsh": "node scripts/run-dsh.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@serialport/parser-readline": "^13.0.0",
    "node": "24.11.1",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1"
  }
}
